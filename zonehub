local PLACE_ROUTES = {}

local function fetchParallel(urls)
    local results = table.create(#urls)
    local done = 0

    for i, url in ipairs(urls) do
        task.spawn(function()
            for attempt = 1, HTTP_RETRIES do
                local result = httpGet(url)
                if type(result) == "string" and #result > 50
                    and not result:find("<!DOCTYPE", 1, true)
                    and not result:find("<html", 1, true)
                    and not (result:match("^%s*{") and result:find('"error"', 1, true)) then
                    results[i] = result
                    break
                end
                if attempt < HTTP_RETRIES then
                    task.wait(RETRY_DELAY_SEC * attempt + math.random() * 0.8)
                end
            end
            done += 1
        end)
    end

    local deadline = os.clock() + 30
    while done < #urls and os.clock() < deadline do
        task.wait(0.05)
    end

    return results
end

local function waitForGameLoaded()
    if not game:IsLoaded() then
        local done = false
        local conn
        conn = game.Loaded:Connect(function()
            done = true
            conn:Disconnect()
        end)
        local start = os.clock()
        while not done and os.clock() - start < 30 do
            task.wait(0.1)
        end
        if conn then conn:Disconnect() end
    end
    task.wait(1.5)
end

local function run()
    waitForGameLoaded()

    local route = GAME_ROUTES[tonumber(game.GameId)]
                or PLACE_ROUTES[tonumber(game.PlaceId)]

    if not route then
        getgenv().ZONEHUB_LOADER_RUNNING = nil
        return
    end

    local results = fetchParallel({ route.Script })
    local source = results[1]

    if not source then
        getgenv().ZONEHUB_LOADER_RUNNING = nil
        return
    end

    local chunk = loadstring(source)
    if type(chunk) ~= "function" then
        getgenv().ZONEHUB_LOADER_RUNNING = nil
        return
    end

    getgenv().ZONEHUB_LOADER_ACTIVE_ROUTE = {
        Name = route.Name,
        LoadedAt = os.time(),
    }

    local ok = pcall(chunk)
    getgenv().ZONEHUB_LOADER_RUNNING = nil
    if ok then
        getgenv().ZONEHUB_LOADER_LOADED = true
    end
end

local ok = pcall(run)
getgenv().ZONEHUB_LOADER_RUNNING = nil
