if getgenv().ZONEHUB_LOADER_RUNNING == true then
    local startedAt = getgenv().ZONEHUB_LOADER_STARTED_AT or 0
    if os.time() - startedAt < 60 then return end
end

getgenv().ZONEHUB_LOADER_RUNNING = true
getgenv().ZONEHUB_LOADER_STARTED_AT = os.time()

local HTTP_RETRIES = 5
local RETRY_DELAY_SEC = 2.0

local _req = (syn and syn.request) or (http and http.request) or (fluxus and fluxus.request) or http_request or request
local function httpGet(url)
    local ok, res = pcall(game.HttpGet, game, url)
    if ok and type(res) == "string" then return res end
    if _req then
        local ok2, resp = pcall(_req, { Url = url, Method = "GET" })
        if ok2 and type(resp) == "table" and type(resp.Body) == "string" then return resp.Body end
    end
    return nil
end

